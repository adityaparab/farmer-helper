# Farmer Helper production configuration example

APP_ENV=production
APP_NAME=farmer-helper
APP_LOG_LEVEL=INFO
APP_REQUEST_TIMEOUT_MS=20000

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://prod_user:replace_me@db-host:5432/farmer_helper
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50
DATABASE_POOL_TIMEOUT_SECONDS=30
EMBEDDING_WORKER_COUNT=4
EMBEDDING_JOB_QUEUE_MAX_SIZE=500

PGVECTOR_DIMENSIONS=1536

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=800

RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_ENABLED=true

ENABLE_TRACING=true
ENABLE_METRICS=true
SENTRY_DSN=replace_me
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production
SECURITY_API_KEY=replace_me
SECURITY_RATE_LIMIT_REQUESTS=120
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
PERFORMANCE_CACHE_MAX_ENTRIES=2000
RETRIEVAL_CACHE_TTL_SECONDS=30
ANSWER_CACHE_TTL_SECONDS=60
LLM_MODEL_LOW_COST=gpt-4.1-mini
LLM_MODEL_HIGH_QUALITY=gpt-4.1
LLM_MODEL_ROUTER_QUESTION_LENGTH_THRESHOLD=120
SESSION_CONTEXT_MAX_CHARS_PER_MESSAGE=300

RATE_LIMIT_PER_MINUTE=30
