# Farmer Helper production configuration example

APP_ENV=production
APP_NAME=farmer-helper
APP_LOG_LEVEL=INFO
APP_REQUEST_TIMEOUT_MS=20000

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://prod_user:replace_me@db-host:5432/farmer_helper
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50

PGVECTOR_DIMENSIONS=1536

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=800

RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_ENABLED=true

ENABLE_TRACING=true
ENABLE_METRICS=true
SENTRY_DSN=replace_me

RATE_LIMIT_PER_MINUTE=30
