# Farmer Helper development configuration example

APP_ENV=development
APP_NAME=farmer-helper
APP_LOG_LEVEL=DEBUG
APP_REQUEST_TIMEOUT_MS=30000

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql+psycopg://dev_user:dev_password@localhost:5432/farmer_helper_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

PGVECTOR_DIMENSIONS=1536

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=1000

RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_ENABLED=false

ENABLE_TRACING=true
ENABLE_METRICS=true
SENTRY_DSN=

RATE_LIMIT_PER_MINUTE=60
