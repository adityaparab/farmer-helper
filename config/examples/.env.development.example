# Farmer Helper development configuration example

APP_ENV=development
APP_NAME=farmer-helper
APP_LOG_LEVEL=DEBUG
APP_REQUEST_TIMEOUT_MS=30000

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:dev_password@localhost:5432/farmer_helper_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=30
EMBEDDING_WORKER_COUNT=2
EMBEDDING_JOB_QUEUE_MAX_SIZE=100

PGVECTOR_DIMENSIONS=1536

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=1000

RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_ENABLED=false

ENABLE_TRACING=true
ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=development
SECURITY_API_KEY=
SECURITY_RATE_LIMIT_REQUESTS=0
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_JWT_SECRET=development-only-change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=14
PERFORMANCE_CACHE_MAX_ENTRIES=512
RETRIEVAL_CACHE_TTL_SECONDS=0
ANSWER_CACHE_TTL_SECONDS=0
LLM_MODEL_LOW_COST=mock-chat-v1
LLM_MODEL_HIGH_QUALITY=mock-chat-v1
LLM_MODEL_ROUTER_QUESTION_LENGTH_THRESHOLD=120
SESSION_CONTEXT_MAX_CHARS_PER_MESSAGE=300

RATE_LIMIT_PER_MINUTE=60
