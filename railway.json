{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn farmer_helper.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 100
  }
}
